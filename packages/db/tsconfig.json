{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Consumed straight from source through the workspace, so nothing is emitted
    // and there is no rootDir to keep drizzle.config.ts out of.
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "drizzle.config.ts"]
}
