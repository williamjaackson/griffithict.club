#!/usr/bin/env bash
# Forced command for the CI deploy key. Installed at /usr/local/bin/gict-deploy.
#
# The key in the deploy user's authorized_keys is restricted to this script:
#
#   command="/usr/local/bin/gict-deploy",no-agent-forwarding,no-port-forwarding,no-pty,no-X11-forwarding ssh-ed25519 AAAA... gict-deploy
#
# So an SSH session with that key cannot open a shell, read files or run docker
# exec. It can ask for one image tag to be deployed. That is the whole blast
# radius if the key ever leaks, which is a very different situation from the usual
# arrangement of handing CI a root key.
set -euo pipefail

STACK_DIR=/opt/gict
TAG="${SSH_ORIGINAL_COMMAND:-}"

# Anything but a commit SHA is rejected, so the tag cannot smuggle in shell.
if [[ ! "$TAG" =~ ^[0-9a-f]{40}$ ]]; then
  echo "Refusing to deploy: expected a 40-character commit SHA, got '${TAG}'" >&2
  exit 1
fi

cd "$STACK_DIR"
export TAG

echo "Pulling $TAG"
docker compose pull --quiet

echo "Starting"
docker compose up -d --remove-orphans

# Untagged layers from previous deploys, not volumes. Data is never touched here.
docker image prune -f --filter "until=168h" >/dev/null 2>&1 || true

echo "Deployed $TAG"
docker compose ps
