# Production environment. Lives at /opt/gict/.env on the VPS, owned by root,
# mode 600. Created by hand once — not synced from GitHub, not a build argument.
#
# Build arguments persist in image layers and the GHCR package is public. Nothing
# here may ever carry a NEXT_PUBLIC_ prefix either, since Next inlines those into
# the client bundle at build time.

# Postgres container bootstrap.
POSTGRES_USER=gict
POSTGRES_PASSWORD=
POSTGRES_DB=gict

# The website's own role. Give each service its own — gict_web, gict_bot — rather
# than sharing the owner. Ten minutes now, an afternoon once the bot ships.
DATABASE_URL=postgres://gict_web:CHANGE_ME@db:5432/gict

# Committee channel that receives sponsorship enquiries.
DISCORD_WEBHOOK_URL=

NEXT_PUBLIC_SITE_URL=https://griffithict.club
