# Local development. Matches compose.dev.yaml.
#
# In production these live in /etc/club/ict-web.env on the host, root-owned and mode 600.
# They are never build arguments: the GHCR image is public and build args persist
# in image layers.
DATABASE_URL=postgres://gict:gict@localhost:5432/gict

# Sponsorship enquiries are posted here. Optional locally — without it the enquiry
# is still stored, and a warning is logged instead. The real value is a secret and
# lives only in /etc/club/ict-web.env on the host.
DISCORD_WEBHOOK_URL=

# Role pinged when any enquiry arrives, sponsorship or general. Not a secret; an
# ID is meaningless without access to the server.
DISCORD_COMMITTEE_ROLE_ID=1344535686241325139

# General enquiries go to their own channel so a student asking a question does
# not land among sponsor leads. Secret; the real value lives on the host.
DISCORD_CONTACT_WEBHOOK_URL=

# Public origin, used for canonical URLs and OG images.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Funnel, the Discord invite tracker in apps/funnel.
#
# The token is a secret and is the one credential here that grants control of the
# bot account itself. Never commit it; .env is gitignored. If it is ever pasted
# somewhere it should not be, reset it in the developer portal rather than hoping.
# The application id is not secret and is only needed to register slash commands.
FUNNEL_BOT_TOKEN=
FUNNEL_APPLICATION_ID=

# Optional. Register slash commands to this one server instead of globally.
# Global registration can take up to an hour to show up in a client, which looks
# exactly like a broken bot; guild registration is instant. Set this while
# developing, remove it to publish for real.
FUNNEL_DEV_GUILD_ID=

# Reimburse, the claims bot in apps/reimburse.
#
# The token is a secret; the application id is not. Needs no privileged intents,
# so nothing to toggle in the developer portal beyond creating the app.
REIMBURSE_BOT_TOKEN=
REIMBURSE_APPLICATION_ID=

# Optional. Register slash commands to this one server instead of globally, which
# is instant rather than taking up to an hour.
REIMBURSE_DEV_GUILD_ID=

# Boost, the booster perks bot in apps/boost.
#
# Needs the Server Members privileged intent switched on in the developer
# portal: without it guildMemberUpdate never fires and a boost starting or
# lapsing is invisible.
BOOST_BOT_TOKEN=
BOOST_APPLICATION_ID=
BOOST_DEV_GUILD_ID=

# Treat these user ids as boosting even when they are not, for testing perks
# without paying for them. Applies in every server the bot is in, so unset it
# when you are done. The bot warns at startup while it is set.
BOOST_TEST_BOOSTERS=
